# ============================================================
# Cygnal Enterprise Environment Configuration Template
# Copy this file to .env and configure for your environment.
# NEVER commit .env or real credentials to version control.
# ============================================================

# ============================================================
# 1. DATABASE CONFIGURATION (SUPABASE MANAGED POSTGRESQL)
# ============================================================
# Option A: Full Supabase Database URL (Recommended for Production)
# - Pooler / Transaction Mode (Port 6543):
# SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# - Direct / Session Mode (Port 5432):
# SUPABASE_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
SUPABASE_DATABASE_URL=

# Option B: Discrete Supabase Database Connection Parameters
# SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.yourprojectref
# SUPABASE_DB_PASSWORD=your_secure_supabase_password
# SUPABASE_DB_SSLMODE=require

# Option C: Standard Local / Self-Hosted PostgreSQL (Optional Dev)
# DATABASE_URL=postgresql://cygnal_user:password@localhost:5432/cygnal_prod
# Note: If no PostgreSQL/Supabase variables are set, Cygnal falls back to SQLite (cygnal.db) for zero-setup local testing.

# ============================================================
# 2. SERVER-ONLY SECRETS & CRYPTOGRAPHIC KEYS (NEVER EXPOSE TO CLIENT)
# ============================================================
# --- JWT Authentication & Rotation ---
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_minimum_64_character_random_hex_string
JWT_SECRET_CURRENT=CHANGE_ME_minimum_64_character_random_hex_string
# JWT_SECRET_PREVIOUS=previous_rotated_key_during_grace_period
JWT_ROTATION_GRACE_HOURS=24
JWT_EXPIRY=3d

# --- Evidence Encryption Master Key (AES-256-GCM Envelope Encryption) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CYGNAL_MASTER_KEK=CHANGE_ME_master_encryption_kek_secret_key_2026

# --- Inbound SIEM Webhook Secret ---
CYGNAL_WEBHOOK_SECRET=CHANGE_ME_strong_random_webhook_secret

# --- Secrets Management Provider ---
# Options: env | gcp | vault (Default: env)
SECRET_PROVIDER=env
# GCP_PROJECT_ID=cygnal-enterprise-prod
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=s.exampleVaultToken

# --- Evidence Storage Vault ---
# Options: local | s3 | gcs (Default: local)
STORAGE_PROVIDER=local
# CYGNAL_S3_BUCKET=cygnal-evidence-vault
# CYGNAL_S3_ENDPOINT=http://minio:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# CYGNAL_GCS_BUCKET=cygnal-evidence-vault-gcs

# --- Redis / Celery Task Queue ---
REDIS_URL=redis://redis:6379/0
USE_CELERY=true

# --- Default Admin Seed Account (optional initial bootstrap) ---
CYGNAL_ADMIN_USERNAME=admin
CYGNAL_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# --- CORS & Allowed Origins ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://cygnal-erj2y01ol-ayushs-projects-ffd48c05.vercel.app

# ============================================================
# 3. PUBLIC / FRONTEND CONFIGURATION (SAFE FOR BROWSER / NEXT.JS)
# ============================================================
# Client-side API URL for Vercel / Next.js builds (Do NOT put database credentials here)
NEXT_PUBLIC_API_URL=https://api.cygnal.cygnalai.com
