# ============================================================
# Cygnal Enterprise Environment Configuration Template
# Copy this file to .env and configure for your environment.
# NEVER commit .env to version control.
# ============================================================

# --- Secrets Management ---------------------------------------
# Options: env | gcp | vault (Default: env)
SECRET_PROVIDER=env

# For GCP Secret Manager:
# GCP_PROJECT_ID=cygnal-enterprise-prod
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# For HashiCorp Vault:
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=s.exampleVaultToken
# VAULT_MOUNT_POINT=secret
# VAULT_PATH_PREFIX=cygnal

# --- Evidence Storage Vault ------------------------------------
# Options: local | s3 | gcs (Default: local)
STORAGE_PROVIDER=local
# CYGNAL_S3_BUCKET=cygnal-evidence-vault
# CYGNAL_S3_ENDPOINT=http://minio:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# CYGNAL_GCS_BUCKET=cygnal-evidence-vault-gcs

# --- Database -------------------------------------------------
POSTGRES_USER=cygnal_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=cygnal_prod
# DATABASE_URL=postgresql://cygnal_user:password@localhost:5432/cygnal_prod

# --- JWT Authentication & Rotation ----------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_minimum_64_character_random_hex_string
JWT_SECRET_CURRENT=CHANGE_ME_minimum_64_character_random_hex_string
# JWT_SECRET_PREVIOUS=previous_rotated_key_during_grace_period
JWT_ROTATION_GRACE_HOURS=24
JWT_EXPIRY=3d

# --- Evidence Encryption Master Key ---------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CYGNAL_MASTER_KEK=CHANGE_ME_master_encryption_kek_secret_key_2026

# --- Webhook Authentication -----------------------------------
CYGNAL_WEBHOOK_SECRET=CHANGE_ME_strong_random_webhook_secret

# --- Redis / Celery -------------------------------------------
REDIS_URL=redis://redis:6379/0
USE_CELERY=true

# --- Admin Seed Account (optional) ---------------------------
CYGNAL_ADMIN_USERNAME=admin
CYGNAL_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# --- CORS -----------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://cygnal-erj2y01ol-ayushs-projects-ffd48c05.vercel.app
